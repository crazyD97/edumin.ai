# Copy to .env and adjust. URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/edumin
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/edumin_test
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Public URL of the web app, used for CORS and links in emails.
APP_URL=http://localhost:5173
# Root domain for school subdomains, e.g. greenwood.edumin.localhost
ROOT_DOMAIN=edumin.localhost
UPLOAD_DIR=./uploads
# console | smtp (smtp driver is a stub to be wired to a provider)
EMAIL_DRIVER=console
# mock | razorpay | stripe (only mock is implemented)
PAYMENT_GATEWAY=mock

# ── Phase A integrations (all optional; unset = simulated/test mode) ──
# Public base URL of the deployed app (used in pay links and WhatsApp attachments)
# PUBLIC_URL=https://app.yourdomain.com
# Encrypts schools' Razorpay keys at rest (defaults to JWT_SECRET)
# SECRETS_KEY=
# Email via Resend: EMAIL_DRIVER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Edumin <no-reply@yourdomain.com>"
# WhatsApp Cloud API (platform number)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# SMS via MSG91 (DLT): JSON map of event → template id
# MSG91_AUTH_KEY=
# MSG91_TEMPLATES={"attendance_absent":"...","fee_reminder":"..."}
# Platform Razorpay account (schools buying message credits)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Web Push: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
