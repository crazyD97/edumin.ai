{
  "name": "@edumin/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "node build.mjs",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:prod": "node --env-file-if-exists=../../.env dist/db/migrate.js"
  },
  "type": "module",
  "dependencies": {
    "@edumin/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
